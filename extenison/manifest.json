{
  "name": "__MSG_appName__",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "version": "1.2.0",
  "manifest_version": 3,
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "permissions": ["identity", "storage"],
  "host_permissions": ["https://mivnbjtehikrqxooogcs.supabase.co/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_icon": "logo.png",
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_appName__"
  },
  "content_scripts": [
    {
      "run_at": "document_end",
      "matches": ["https://www.upwork.com/*/proposals/job*", "https://*.hamidnawaz.com/*"],
      "js": ["lib/ui.js", "content/proposals.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/ui.css", "logo.png"],
      "matches": ["https://www.upwork.com/*", "https://*.hamidnawaz.com/*"]
    }
  ]
}
